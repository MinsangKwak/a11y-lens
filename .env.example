# Supabase 프로젝트 주소와 공개 키.
#
# MAIN_VITE_ 접두사는 electron-vite 가 **메인 프로세스에만** 넘기라는 표시다.
# 접두사를 떼면 값이 전달되지 않고, RENDERER_VITE_ 로 바꾸면 렌더러 번들에 박힌다.
#
# 이 키는 공개 브라우저 식별자이고 서버 비밀이 아니다 — 격리는 키를 숨겨서가 아니라
# db/schema.sql 의 RLS 가 한다. 대시보드에서 publishable key 로 표시되기도 한다.
# service_role · secret 이 붙은 키는 RLS 를 무시하므로 여기 넣지 않는다.
MAIN_VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
MAIN_VITE_SUPABASE_ANON_KEY=

# schema.sql 을 psql 로 올릴 때만 쓴다. SQL Editor 에 붙여넣으면 필요 없다
DATABASE_URL=
